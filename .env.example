APP_NAME="DocuMind AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=documind
DB_USERNAME=root
DB_PASSWORD=
# For SQLite instead, set DB_CONNECTION=sqlite and touch database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Web configuration is public client config, not an Admin SDK key.
FIREBASE_API_KEY=AIzaSyBGYCWtQ3ULVqP5QDum7Qhz14bD2PPcTaQ
FIREBASE_AUTH_DOMAIN=schoolss-fb542.firebaseapp.com
FIREBASE_PROJECT_ID=schoolss-fb542
FIREBASE_STORAGE_BUCKET=schoolss-fb542.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=253220830799
FIREBASE_APP_ID=1:253220830799:web:6f9e02dc3a7b3bfc64743a
FIREBASE_MEASUREMENT_ID=G-C6HW7S2VBK

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=60

# -----------------------------------------------------------------------------
# Retrieval / chunking
# -----------------------------------------------------------------------------
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_CHUNK_MAX=620
RAG_CHUNK_MIN=40
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.15
RAG_HYBRID=true
RAG_RRF_K=60
RAG_RETRIEVAL_POOL=20
RAG_CONTEXT_NEIGHBOUR_CHARS=220
RAG_KEYWORD_CONFIDENCE=0.5
RAG_MAX_CHUNKS=5000
RAG_MAX_DOC_TOKENS=4000000
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_BATCH_SIZE=64
RAG_HISTORY_MESSAGES=6
RAG_HISTORY_CHARS=3000
RAG_SNIPPET_CHARS=400
RAG_SUMMARY_SLICES=6
RAG_SUMMARY_SLICE_CHARS=2400
RAG_SUMMARY_COMBINE_CHARS=3200
RAG_STREAM_ENABLED=true
# Driver for embeddings + chat: "local" (our own Python models, no API),
# "openai" (OpenAI API key required) or "fake" (offline demo, no AI at all).
RAG_AI_DRIVER=local

# -----------------------------------------------------------------------------
# Local model service (the ml/ Python container)
# -----------------------------------------------------------------------------
ML_ENABLED=true
ML_BASE_URL=http://ml:8090/v1
ML_CHAT_MODEL=Qwen/Qwen2.5-1.5B-Instruct-GGUF
ML_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ML_TIMEOUT=300

# -----------------------------------------------------------------------------
# Billing
# -----------------------------------------------------------------------------
BILLING_WELCOME_CREDITS=10
BILLING_CREDITS_PER_MESSAGE=1
BILLING_REGISTRATION_ENABLED=true
BILLING_CURRENCY=INR

# Razorpay Checkout key pair (Dashboard -> Settings -> API keys).
# Leave empty to hide card payments until you are ready to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# -----------------------------------------------------------------------------
# Documents
# -----------------------------------------------------------------------------
DOCUMENT_MAX_SIZE_KB=25600
DOCUMENT_MAX_PER_USER=50
DOCUMENT_DISK=local

